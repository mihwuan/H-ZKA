# SHA256 checksums for H-ZKA key artifacts
# Format: <SHA256_HASH>  <path relative to the HZKA/ directory>
#
# Verify (Linux):   cd HZKA && sha256sum -c ../SHA256SUMS
# Verify (macOS):   cd HZKA && shasum -a 256 -c ../SHA256SUMS
# Verify (Windows): cd HZKA; Get-Content ..\SHA256SUMS | Where-Object { $_ -notmatch '^#' -and $_.Trim() } | ForEach-Object {
#                     $h,$p = $_ -split '  ',2
#                     if ((Get-FileHash $p -Algorithm SHA256).Hash -ne $h.ToUpper()) { "FAILED: $p" } }
#
# Covers every *.json and *.csv under HZKA/result/, which is every raw output
# behind a derived table.  artifact-manifest.csv maps each manuscript table to
# the driver that produces it.
#
# Regenerate (Linux/macOS):
#   cd HZKA && find result -type f \( -name '*.json' -o -name '*.csv' \) \
#     -not -path '*/build_agg/*' | LC_ALL=C sort | xargs shasum -a 256 > ../SHA256SUMS.new
#
# The E2 adaptive-adversary driver also emits e2_ceiling_reputation_trace.csv and
# e2_ceiling_recovery.csv, which carry the near-threshold reputation sequence
# quoted in the manuscript.
#
# agg.r1cs special case:
# The file named agg.r1cs in the circuit harness is an empty placeholder (0 bytes)
# retained for command-line compatibility; the witness stage does not read it.
# Its SHA-256 is therefore the hash of the empty string,
# e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855,
# and it identifies nothing.  The constraint system is identified instead by the
# circuit source hash, the recorded constraint count, and the proving-key hash.
# It is excluded from this list by .gitignore and is not part of the archive.
